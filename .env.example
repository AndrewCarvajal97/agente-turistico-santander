# ==========================================================================
# Configuración del Agente IA - Guía Turística de Santander
# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ==========================================================================

# --- Proveedor de LLM: "gemini" o "groq" ---
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_CHAT_MODEL=gemini-flash-latest
# Tope de tokens de salida (amplio para que no se trunquen las respuestas).
MAX_OUTPUT_TOKENS=50000

# --- Groq (LLM_PROVIDER=groq) - modelos open source, free tier generoso ---
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- Documento fuente ---
PDF_PATH=data/guia_turistica_santander.pdf

# --- Memoria de conversaciones (CSV único con pandas) ---
HISTORY_CSV=data/historial.csv
# Cuántos intercambios recientes de la sesión se usan como contexto.
MEMORY_MAX_TURNS=6
