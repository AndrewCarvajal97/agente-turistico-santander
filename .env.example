# ==========================================================================
# Configuración del Agente IA - Guía Turística de Santander
# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ==========================================================================

# --- Proveedor de LLM: "gemini", "groq" o "cohere" ---
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_CHAT_MODEL=gemini-flash-latest
# Tope de tokens de salida (amplio para que no se trunquen las respuestas).
MAX_OUTPUT_TOKENS=50000

# --- Groq (LLM_PROVIDER=groq) - modelos open source, free tier generoso ---
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_groq
GROQ_MODEL=llama-3.3-70b-versatile
# Modelos de respaldo si el principal se queda sin cupo (cada uno con su cuota diaria).
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,gemma2-9b-it

# --- Cohere (LLM_PROVIDER=cohere) - fuerte en contexto en español ---
# Obtén tu clave gratuita (trial) en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=tu_api_key_cohere
COHERE_MODEL=command-r-08-2024
# Modelo de embeddings de Cohere (usado por el RAG en /rag/ask).
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# --- RAG (recuperación por embeddings + base vectorial), vía paralela a /ask ---
# Directorio con los PDFs que indexa el RAG (todos los *.pdf de la carpeta).
RAG_DOCS_DIR=data
# Backend de base vectorial (strategy): "faiss" (local/persistido) o "pinecone" (nube).
RAG_VECTORSTORE=faiss
# Carpeta donde se persiste el índice FAISS (evita re-indexar en cada arranque).
RAG_INDEX_DIR=data/faiss_index
# Proveedor de embeddings: "cohere" (gratis en el trial) o "gemini".
RAG_EMBED_PROVIDER=cohere
# Estrategia de chunking: "recursive" (por caracteres) o "semantic" (por significado).
RAG_CHUNKING=recursive
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
# Umbral mínimo de similitud. 0 (por defecto) = similarity top-k puro (mejor recall).
# Un valor > 0 activa el filtro por umbral (ojo: en FAISS el score es distancia L2).
RAG_SCORE_THRESHOLD=0
# Multi-query (RAG avanzado, opt-in): genera N variantes de la pregunta y une resultados.
# Mejora el recall, pero suma una llamada extra al LLM por consulta.
RAG_MULTIQUERY=false
RAG_MULTIQUERY_N=3

# --- Pinecone (base vectorial en la nube, solo si RAG_VECTORSTORE=pinecone) ---
# Crea tu cuenta y API key gratis en: https://app.pinecone.io
PINECONE_API_KEY=tu_api_key_pinecone
# Nombre del índice (se crea automáticamente si no existe, con la dimensión correcta).
PINECONE_INDEX=santander-rag
# Región serverless (plan gratuito: AWS us-east-1).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Documento fuente ---
PDF_PATH=data/guia_turistica_santander.pdf

# --- Memoria de conversaciones (CSV único con pandas) ---
HISTORY_CSV=data/historial.csv
# Cuántos intercambios recientes de la sesión se usan como contexto.
MEMORY_MAX_TURNS=6

# --- Administración ---
# Clave para acciones de admin (ej. análisis de conversaciones). Elige una propia.
ADMIN_KEY=cambia-esta-clave

# --- Tavily (búsqueda web para el agente orquestador /agente, OPCIONAL) ---
# Da acceso a internet para info actual (eventos, clima, precios) que no está en el PDF.
# Consigue tu clave gratuita (~1000 búsquedas/mes) en: https://tavily.com
TAVILY_API_KEY=tuclaveapiaqui
# Tope de pasos del agente orquestador ReAct (evita bucles y gasto de cuota). ~2 pasos = 1 tool.
AGENTE_MAX_PASOS=12

# --- LangSmith (observabilidad/tracing, OPCIONAL) ---
# Si lo activas, LangChain envía el trace de cada cadena (chunks recuperados, prompt,
# tokens, latencia) a LangSmith. Es opt-in: sin estas variables, todo funciona igual.
# Crea tu cuenta y API key gratis en: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=tu_api_key_langsmith
LANGSMITH_PROJECT=agente-santander
