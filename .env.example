# ==========================================================================
# Configuración del Agente IA - Guía Turística de Santander
# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ==========================================================================

# --- Proveedor de LLM: "gemini", "groq" o "cohere" ---
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_CHAT_MODEL=gemini-flash-latest
# Tope de tokens de salida (amplio para que no se trunquen las respuestas).
MAX_OUTPUT_TOKENS=50000

# --- Groq (LLM_PROVIDER=groq) - modelos open source, free tier generoso ---
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_groq
GROQ_MODEL=llama-3.3-70b-versatile
# Modelos de respaldo si el principal se queda sin cupo (cada uno con su cuota diaria).
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,gemma2-9b-it

# --- Cohere (LLM_PROVIDER=cohere) - fuerte en contexto en español ---
# Obtén tu clave gratuita (trial) en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=tu_api_key_cohere
COHERE_MODEL=command-r-08-2024
# Modelo de embeddings de Cohere (usado por el RAG en /rag/ask).
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# --- RAG (recuperación por embeddings + FAISS), vía paralela a /ask ---
# Proveedor de embeddings: "cohere" (gratis en el trial) o "gemini".
RAG_EMBED_PROVIDER=cohere
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
# Umbral mínimo de similitud (0-1); descarta fragmentos poco relevantes.
RAG_SCORE_THRESHOLD=0.3

# --- Documento fuente ---
PDF_PATH=data/guia_turistica_santander.pdf

# --- Memoria de conversaciones (CSV único con pandas) ---
HISTORY_CSV=data/historial.csv
# Cuántos intercambios recientes de la sesión se usan como contexto.
MEMORY_MAX_TURNS=6

# --- Administración ---
# Clave para acciones de admin (ej. análisis de conversaciones). Elige una propia.
ADMIN_KEY=cambia-esta-clave
